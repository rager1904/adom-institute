# ===========================================================================
# ADOM Institute - PRODUCTION environment (OCI)
# Copy to /opt/adom/app/.env on the VM (never commit secrets!).
# Generate a strong SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# ===========================================================================

# --- Django ---
DEBUG=False
SECRET_KEY=CHANGE_ME_generate_with_python_secrets
# Comma-separated. Use your real domain, NOT localhost/127.0.0.1 (settings refuse those in prod).
ALLOWED_HOSTS=app.yourdomain.com
# OPTIONAL_ALLOWED_HOSTS_2=app2.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# --- Email (replace console backend with real SMTP in production) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=outgoing@yourdomain.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=ADOM Institute <noreply@yourdomain.com>

# --- Database (via PgBouncer inside the compose network) ---
DB_ENGINE=postgresql
DB_NAME=adom_institute
DB_USER=adom_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=pgbouncer
DB_PORT=5432
DB_CONN_MAX_AGE=300

# Used by the postgres container itself (keep in sync with the above)
POSTGRES_DB=adom_institute
POSTGRES_USER=adom_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis (cache / channels / broker) ---
REDIS_HOSTS=redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1
REDIS_CHANNEL_URL=redis://redis:6379/2
REDIS_MAXMEMORY=512mb

# --- AI (disabled in production on free-tier ARM; enable only with a GPU box) ---
ADOM_INSTITUTE_AI_ENABLED=False

# --- Object storage (S3-compatible). Leave USE_S3=False to serve files from
#     the VM locally. Set True for OCI Object Storage (recommended at scale).
#     Get S3-compatible keys: Identity & Security -> User -> Customer Secret Keys ---
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=adom-media
# AWS_S3_REGION_NAME=us-ashburn-1
# AWS_S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# AWS_QUERYSTRING_AUTH=True

# --- Security ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- DRF throttling (4 schools = high bursty API traffic during registration) ---
DRF_ANON_THROTTLE_RATE=200/hour
DRF_USER_THROTTLE_RATE=6000/hour

# --- Worker sizing (used by compose interpolation) ---
WEB_WORKERS=2
WEB_THREADS=4
WEB_MAX_REQUESTS=1000
CELERY_CONCURRENCY=2

# --- Backup (host cron -> docker compose + aws cli -> bucket) ---
BACKUP_BUCKET=adom-backups
BACKUP_RETENTION_DAYS=14
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com