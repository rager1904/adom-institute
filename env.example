# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=sqlite
SQLITE_DB_NAME=adom.sqlite3
# Optional absolute SQLite path. Leave unset to use the OS temp directory.
# SQLITE_DB_PATH=C:\temp\adom.sqlite3
DB_NAME=adom_institute
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@adominstitute.com

# Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ADOM Institute AI Configuration - open-source models only by default
ADOM_INSTITUTE_AI_ENABLED=False
ADOM_INSTITUTE_AI_PROVIDER=ollama
ADOM_INSTITUTE_AI_CHAT_MODEL=qwen2.5:7b-instruct
ADOM_INSTITUTE_AI_REASONING_MODEL=deepseek-r1:8b
ADOM_INSTITUTE_AI_EMBEDDING_MODEL=BAAI/bge-m3
ADOM_INSTITUTE_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ADOM_INSTITUTE_AI_VECTOR_STORE=pgvector
OLLAMA_BASE_URL=http://localhost:11434

# File Storage (AWS S3 - Optional)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Development Settings
DJANGO_SETTINGS_MODULE=adom.settings
