# Normalize line endings for text files
* text=auto

# Shell scripts MUST be LF (CRLF breaks them on Linux)
*.sh       text eol=lf
*.bash     text eol=lf
entrypoint.sh text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Terraform
*.tf          text eol=lf
*.tfvars      text eol=lf
*.hcl         text eol=lf

# YAML / configs
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# PowerShell (works either way, keep LF for consistency)
*.ps1   text eol=lf